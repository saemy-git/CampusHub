# =======================================================
# CAMPUSHUB BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# =======================================================

# Server Configuration
PORT=5000
NODE_ENV=development
# Production: Set FRONTEND_ORIGIN to your GitHub Pages URL e.g. https://your-username.github.io
FRONTEND_ORIGIN=http://localhost:3000

# Supabase PostgreSQL Database Connection URL
# Replace with your Supabase Transaction Pooler or Direct Connection string:
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# JWT Authentication Secret
JWT_SECRET=campushub-super-secret-jwt-key-2026-change-in-production
JWT_EXPIRES_IN=7d

# Transactional Email (SMTP Configuration)
# NOTE: In local development, if SMTP settings are empty,
# OTPs will automatically output to the backend console logs for instant testing.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM="CampusHub <no-reply@campushub.edu>"
